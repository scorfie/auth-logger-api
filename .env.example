PORT=3000

# Firebase service account credentials (from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Data retention: events older than this are deleted on a daily cron schedule
RETENTION_ENABLED=true
RETENTION_DAYS=30
RETENTION_CRON=0 3 * * *

# Key required in the "x-admin-key" header to call POST /api/admin/retention/run.
# Leave unset to disable the manual endpoint entirely.
ADMIN_API_KEY=
